{
  "globalQuery": "path does not include Modèles (inclus)",
  "globalFilter": "",
  "removeGlobalFilter": false,
  "taskFormat": "dataview",
  "setCreatedDate": false,
  "setDoneDate": true,
  "setCancelledDate": true,
  "autoSuggestInEditor": true,
  "autoSuggestMinMatch": 3,
  "autoSuggestMaxItems": 4,
